# ─── Development Environment ─────────────────────────────────
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real secrets.

# ─── Database ────────────────────────────────────────────────
# Neon PostgreSQL connection string
# Format: postgresql://user:password@host/database?sslmode=require
# Get your connection string from Neon Console → Connection Details
DATABASE_URL="postgresql://neondb_owner:your-password@ep-your-endpoint.us-east-2.aws.neon.tech/church_management_dev?sslmode=require"

# ─── Authentication ──────────────────────────────────────────
# JWT secret for session tokens (min 32 characters)
JWT_SECRET="dev-jwt-secret-change-in-production-min-32-chars"

# Session expiry in seconds (default: 7 days)
SESSION_EXPIRY="604800"

# Mobile session expiry in seconds (default: 1 hour)
MOBILE_ACCESS_TOKEN_EXPIRY="3600"

# Google sign-in is not part of the review edition.

# Public twin of the same value — the browser needs it to load Google
# Identity Services. Keep both set to the identical client ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# ─── Application ─────────────────────────────────────────────
# Environment: development | staging | production
NEXTJS_ENV="development"

# App URL for redirects
APP_URL="http://localhost:3000"

# ─── Friday Demo Clock (development only) ───────────────────
# Enables the demo attendance clock (simulated 09:00–13:00 Friday window).
# Honoured automatically in development; production ALWAYS uses the real clock
# unless this is explicitly set to "true" for a live demo deployment.
ENABLE_DEMO_CLOCK="true"

# ─── Future: Realtime ────────────────────────────────────────
# WebSocket endpoint for realtime events
# REALTIME_URL="wss://realtime.example.com"

# ─── Future: AI Providers ────────────────────────────────────
# AI_PROVIDER="openai"
# AI_API_KEY="sk-..."
# AI_MODEL="gpt-4"

# ─── Firebase Cloud Messaging (FCM) ───────────────────────────
# Firebase Server Key or Cloud Messaging API Key for background push notifications
FCM_SERVER_KEY="AIzaSy..."
